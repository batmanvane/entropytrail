# Queue for the nightly run window (sourced by scripts/night-studio.sh).
# Paths are relative to the repo root. Change here, no launchd reload needed.
ET_CONDITION=configs/conditions/qwen35-9b-bf16-mlx-t0p7.yaml
ET_PROMPTS=prompts/prompts.yaml
ET_SAMPLES=20
# Space-separated prompt ids; empty = all prompts. Grid queue only.
ET_PROMPT_IDS="${ET_PROMPT_IDS-}"
# Fork queue (WP5): path of a fork plan relative to the repo root; empty = grid queue.
# When set, the night runs the rollouts of this plan instead of the grid (ET_SAMPLES is
# ignored; ET_PROMPT_IDS must be empty).
ET_FORK_PLAN="${ET_FORK_PLAN-}"
# Day window (scripts/day-studio.sh): 1 = run the grid queue above (ET_CONDITION,
# ET_SAMPLES, ET_PROMPT_IDS) in the day window too; a fork plan takes precedence.
ET_DAY_GRID="${ET_DAY_GRID-1}"
